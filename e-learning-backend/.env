# Environment Configuration - SECURE VERSION
# Use environment variables or secret management service
# NEVER commit plaintext secrets to version control

# MongoDB Configuration - Use environment variables
MONGODB_USERNAME=${MONGODB_USERNAME}
MONGODB_PASSWORD=${MONGODB_PASSWORD}
MONGO_URI=mongodb+srv://${MONGODB_USERNAME}:${MONGODB_PASSWORD}@cluster0.1eywscy.mongodb.net/elearning?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=${JWT_SECRET}

# Email Service Configuration
EMAIL_USER=${EMAIL_SERVICE_USER}
EMAIL_PASS=${EMAIL_SERVICE_PASSWORD}
GMAIL_WEBHOOK_URL=${GMAIL_WEBHOOK_URL}

# Judge0 Configuration (Code Testing Platform)
JUDGE0_URL=${JUDGE0_URL}
JUDGE0_TOKEN=${JUDGE0_TOKEN}

# LiveKit Configuration (Video Conferencing)
LIVEKIT_URL=${LIVEKIT_URL}
LIVEKIT_API_KEY=${LIVEKIT_API_KEY}
LIVEKIT_API_SECRET=${LIVEKIT_API_SECRET}

# Frontend URL for CORS and redirects
FRONTEND_URL=${FRONTEND_URL}
ALLOWED_ORIGINS=${ALLOWED_ORIGINS}

# Application Configuration
PORT=5000
MAX_GRADING_JOBS=15
NODE_ENV=production

# Security Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
CORS_MAX_AGE=3600

# Session Configuration
SESSION_SECRET=${SESSION_SECRET}
SESSION_TIMEOUT=3600000

# Email Configuration
EMAIL_FROM_NAME="Destination Career"
EMAIL_REPLY_TO="support@destinationcareer.com"

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Password Requirements
MIN_PASSWORD_LENGTH=8
REQUIRE_UPPERCASE=true
REQUIRE_LOWERCASE=true
REQUIRE_NUMBERS=true
REQUIRE_SPECIAL_CHARS=true

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_AUTH_REQUESTS=5
RATE_LIMIT_MAX_GENERAL_REQUESTS=1000

# Security Headers Configuration
ENABLE_HSTS=true
ENABLE_CSP=true
ENABLE_XFRAME_OPTIONS=true
ENABLE_XSS_PROTECTION=true
ENABLE_CONTENT_TYPE_OPTIONS=true

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=/var/log/app/application.log
ENABLE_REQUEST_LOGGING=true

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=9090

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/backups

# External Service Timeouts
JUDGE0_TIMEOUT=30000
LIVEKIT_TIMEOUT=10000
EMAIL_TIMEOUT=15000

# Database Configuration
DB_POOL_SIZE=10
DB_SERVER_SELECTION_TIMEOUT=5000
DB_SOCKET_TIMEOUT=45000

# Cache Configuration
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_DB=0
CACHE_TTL=3600

# API Keys for Third Party Services
GOOGLE_MAPS_API_KEY=${GOOGLE_MAPS_API_KEY}
STRIPE_SECRET_KEY=${STRIPE_SECRET_KEY}
TWILIO_ACCOUNT_SID=${TWILIO_ACCOUNT_SID}

# Social Media Integration
FACEBOOK_APP_ID=${FACEBOOK_APP_ID}
FACEBOOK_APP_SECRET=${FACEBOOK_APP_SECRET}
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}

# Analytics and Tracking
ANALYTICS_TRACKING_ID=${ANALYTICS_TRACKING_ID}
ANALYTICS_SECRET_KEY=${ANALYTICS_SECRET_KEY}

# Maintenance Configuration
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="System under maintenance. Please try again later."

# API Security
API_KEY=${API_KEY}
API_RATE_LIMIT=1000

# File Upload Security
MAX_UPLOAD_SIZE=52428800
SCAN_UPLOADS=true
QUARANTINE_UPLOADS=true

# Communication Settings
DEFAULT_EMAIL_SUBJECT="Destination Career Notification"
PASSWORD_RESET_EXPIRY_HOURS=1
EMAIL_VERIFICATION_EXPIRY_HOURS=24

# User Registration Configuration
REQUIRE_EMAIL_VERIFICATION=true
REQUIRE_PHONE_VERIFICATION=false
AUTO_APPROVE_ADMIN=false
AUTO_APPROVE_TRAINER=false

# Session Security
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAME_SITE=strict
SESSION_COOKIE_MAX_AGE=86400000

# Rate Limiting Exemptions
RATE_LIMIT_EXEMPT_IPS=127.0.0.1,192.168.1.0/24
RATE_LIMIT_EXEMPT_PATHS=/health,/metrics,/api/v1/health

# Backup and Recovery
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=${BACKUP_ENCRYPTION_KEY}

# SSL/TLS Configuration
SSL_CERT_PATH=${SSL_CERT_PATH}
SSL_KEY_PATH=${SSL_KEY_PATH}
SSL_CAFILE_PATH=${SSL_CAFILE_PATH}

# Load Balancer Configuration
LOAD_BALANCER_HEALTH_CHECK_INTERVAL=30000
LOAD_BALANCER_HEALTH_CHECK_TIMEOUT=5000

# Application-specific Configurations
ASSIGNMENT_MAX_SIZE=10485760
APPLICATION_MAX_SIZE=52428800
VIDEO_MAX_DURATION=3600
AUDIO_MAX_DURATION=7200

# Third-party API Timeouts
EXTERNAL_API_TIMEOUT=30000
WEBHOOK_TIMEOUT=10000

# Database Configuration
DB_HOST=${DB_HOST}
DB_PORT=27017
DB_NAME=elearning
DB_SSL_ENABLED=true

# Message Queue Configuration
RABBITMQ_URL=${RABBITMQ_URL}
RABBITMQ_QUEUE_PREFIX=app.

# Cache Configuration
REDIS_URL=${REDIS_URL}
REDIS_TLS_ENABLED=true

# Analytics Configuration
ANALYTICS_BATCH_SIZE=100
ANALYTICS_FLUSH_INTERVAL=30000

# Security Configuration
ENFORCE_2FA=false
MFA_EXEMPT_IPS=127.0.0.1

# Internationalization
DEFAULT_LOCALE=en-US
SUPPORTED_LOCALES=en-US,es-ES,fr-FR,de-DE

# Feature Flags
ENABLE_FEATURE_X=true
ENABLE_FEATURE_Y=false

# Monitoring
PROMETHEUS_ENDPOINT=/metrics
GRAFANA_DASHBOARD_URL=${GRAFANA_DASHBOARD_URL}

# Compliance
GDPR_COMPLIANCE=true
CCPA_COMPLIANCE=true
HIPAA_COMPLIANCE=false

# Backup Encryption
ENCRYPT_BACKUPS=true
BACKUP_ENCRYPTION_ALGORITHM=aes-256-gcm

# API Documentation
API_DOCS_ENABLED=true
API_DOCS_PATH=/docs

# Custom Configuration
CUSTOM_SETTING_1=value1
CUSTOM_SETTING_2=value2

# End of .env configuration